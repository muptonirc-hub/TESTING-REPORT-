    "kg": "load in kg",
    "N": "force in N",
    "reps": "repetitions"
  },
  "score_units": {
    "xBW": "× BW from a load: kg ÷ body mass",
    "pctBW": "% BW from a load: kg ÷ body mass × 100",
    "Nkg": "N/kg from a force: N ÷ body mass",
    "xBWf": "× BW from a force: N ÷ (body mass × 9.81)",
    "reps": "repetitions as entered",
    "ratio": "calculated from two other tests"
  },
